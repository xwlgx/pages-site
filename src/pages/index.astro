---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Section from '../components/Section.astro';
import { site } from '../data/site';
---

<BaseLayout title={`${site.name} · ${site.role}`} description={site.intro}>
  <SiteHeader />

  <main>
    <section class="container-page pb-14 pt-16 sm:pt-20">
      <p class="text-xs text-page-muted">{site.status}</p>
      <h1 class="mt-4 max-w-[20ch] text-3xl font-semibold leading-[1.35] sm:text-4xl">
        {site.headline}
      </h1>
      <p class="mt-5 max-w-[38em] text-base leading-relaxed text-page-muted">
        {site.intro}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a class="btn-primary" href={`mailto:${site.email}`}>邮件联系</a>
        <a class="btn-ghost" href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      </div>
      <ul class="mt-10 flex flex-wrap gap-2">
        {site.domains.map((domain) => <li class="tag">{domain}</li>)}
      </ul>
    </section>

    <Section id="work" title="方向" note="按业务场景组织">
      <div class="grid gap-4 sm:grid-cols-3">
        {
          site.directions.map((item) => (
            <article class="rounded-xl border border-page bg-card p-5">
              <h3 class="text-sm font-medium">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-page-muted">{item.desc}</p>
            </article>
          ))
        }
      </div>
    </Section>

    {
      site.posts.length > 0 && (
        <Section id="writing" title="文章" note={`${site.posts.length} 篇`}>
          <ul>
            {site.posts.map((post) => (
              <li class="border-t border-page py-3 first:border-t-0">
                <a class="flex items-baseline justify-between gap-4 no-underline" href={post.href}>
                  <span class="text-sm">{post.title}</span>
                  <span class="shrink-0 text-xs text-page-muted">{post.date}</span>
                </a>
              </li>
            ))}
          </ul>
        </Section>
      )
    }

    <Section id="about" title="关于">
      <p class="max-w-[38em] text-sm leading-relaxed text-page-muted">{site.about}</p>
      <ul class="mt-6 flex flex-wrap gap-2">
        {site.stack.map((item) => <li class="tag">{item}</li>)}
      </ul>
      <div class="mt-8 flex flex-wrap gap-6 text-sm">
        <a class="link-inline" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="link-inline" href={site.github} target="_blank" rel="noreferrer">
          github.com/{site.handle}
        </a>
      </div>
    </Section>
  </main>

  <SiteFooter />
</BaseLayout>
