---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="页面不存在" description="访问的页面不存在">
  <SiteHeader />
  <main class="container-page flex min-h-[60vh] flex-col justify-center py-16">
    <p class="text-xs text-page-muted">404</p>
    <h1 class="mt-3 text-2xl font-semibold">这里没有内容</h1>
    <p class="mt-4 text-sm text-page-muted">链接可能已经失效，或者页面还没写。</p>
    <a class="btn-ghost mt-8 w-fit" href={base}>返回首页</a>
  </main>
  <SiteFooter />
</BaseLayout>
