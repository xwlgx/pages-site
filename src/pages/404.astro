---
import '../styles/global.css';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>页面不存在</title>
  </head>
  <body class="bg-page text-page">
    <main class="mx-auto flex min-h-screen w-full max-w-3xl flex-col justify-center px-6">
      <p class="text-sm text-page-muted">404</p>
      <h1 class="mt-3 text-3xl font-semibold">这里没有内容</h1>
      <p class="mt-4 text-base text-page-muted">链接可能已失效，请返回首页。</p>
      <a class="mt-8 w-fit rounded-full border border-page px-4 py-2 text-sm" href={import.meta.env.BASE_URL}>
        返回首页
      </a>
    </main>
  </body>
</html>
