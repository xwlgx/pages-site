---
interface Props {
  id: string;
  title: string;
  note?: string;
}

const { id, title, note } = Astro.props;
---

<section id={id} class="border-t border-page py-14 sm:py-16">
  <div class="container-page">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
      <h2 class="text-lg font-medium">{title}</h2>
      {note && <span class="text-xs text-page-muted">{note}</span>}
    </div>
    <div class="mt-6">
      <slot />
    </div>
  </div>
</section>
